# Copy to .env for local development. Never commit the real file.
DATABASE_URL=postgresql://eventseat:eventseat@localhost:5432/eventseat
TEST_DATABASE_URL=postgresql://eventseat:eventseat@localhost:5433/eventseat_test

# Generate a real one for any deployment: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this dev value when COOKIE_SECURE=true.
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_EXPIRE_MINUTES=60

COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Set true for serverless/pooled Postgres such as Neon.
USE_NULL_POOL=false

ENABLE_DEMO_TOOLS=true
RUN_SEED_ON_STARTUP=true

HOLD_TTL_SECONDS=300
SWEEPER_INTERVAL_SECONDS=60